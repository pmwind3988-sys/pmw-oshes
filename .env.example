VITE_APP_NAME=PMW OSHES Forms
VITE_DEPARTMENT_NAME=OSHES

VITE_AZURE_CLIENT_ID=your-azure-ad-client-id
VITE_AZURE_TENANT_ID=your-azure-ad-tenant-id
VITE_SP_SITE_URL=https://tenant.sharepoint.com/sites/PMW-OSHES

# Copy these from SharePoint rather than typing them — they are compared as
# literal strings against the group Title, and a mismatch denies access exactly
# as a genuine non-membership does. List the real names with:
#   <site-url>/_api/web/sitegroups?$select=Title
# The site's built-in "<Site Name> Owners" group is a valid choice for the admin
# role; see SETUP.md section A2 for what that widens.
VITE_OSHES_ADMIN_GROUP=Your OSHES Site Owners
VITE_OSHES_AUDITOR_GROUP=
VITE_OSHES_SLA_DEFAULT_DAYS=3

VITE_API_SECRET_KEY=change-me-to-a-random-string
API_SECRET_KEY=change-me-to-the-same-random-string
CRON_SECRET=change-me-to-a-separate-random-string

SYSTEM_CLIENT_ID=your-system-app-client-id
SYSTEM_CLIENT_SECRET=your-system-app-client-secret
SHAREPOINT_CERT_PFX_BASE64=base64-encoded-pfx
SHAREPOINT_CERT_PASSWORD=your-pfx-export-password

OSHES_FORM_EMAIL_FROM_ADDRESS=oshes-forms@example.com
EMAIL_FROM_ADDRESS=shared-fallback@example.com
# Same sender mailbox, exposed to the browser so the form page can recognise it.
VITE_OSHES_FORM_EMAIL_FROM_ADDRESS=oshes-forms@example.com
# Sentinel mailbox meaning "handle this layer on paper" — a workflow layer that
# resolves to this address is marked manual and gets a PDF instead of a review link.
# Leave blank to disable manual-paper routing entirely.
VITE_OSHES_MANUAL_PAPER_ADDRESS=
VITE_PDPA_CONTACT_EMAIL=pdpa@example.com
# Two separate variables. The VITE_ one is what the privacy notice displays; the
# un-prefixed one is what api/submit-form.ts writes into RetentionUntil. Keep them
# equal — changing only one makes the notice disagree with the stored data.
VITE_PDPA_RETENTION_YEARS=7
PDPA_RETENTION_YEARS=7
VITE_APP_BASE_URL=https://pmw-oshes.example.com

# Origin of the pmw-hrform deployment that hosts the shared form builder. The
# portal appends /admin/builder?site=oshes and opens it in a new tab for admins.
# Same tenant and Entra app, so the hand-off is a silent SSO. Blank hides the link.
VITE_BUILDER_URL=https://pmw-hrform.vercel.app

# ── Optional. The code has working defaults for everything below. ────────────
# Domains treated as internal staff addresses. Comma-separated.
VITE_INTERNAL_EMAIL_DOMAINS=pmw-group.com
# Bump to re-capture PDPA consent after the notice text changes.
VITE_PDPA_NOTICE_VERSION=PDPA-MY-OSHES-2026-06-25
# info | warn | error. Defaults to warn in production, info otherwise.
API_LOG_LEVEL=warn

# Never set VITE_AZURE_CLIENT_SECRET. api/_utils/graphClient.ts accepts it as a
# legacy fallback for SYSTEM_CLIENT_SECRET, but the VITE_ prefix would compile
# the app-only client secret into the public browser bundle.
